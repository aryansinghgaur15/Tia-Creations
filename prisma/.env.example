// .env.example — TIA Creations marketplace
// Copy to .env and fill values. Never commit the real .env.

DATABASE_URL="postgresql://user:password@localhost:5432/tia_creations?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-too"
TOKEN_EXPIRY="900"          // 15 min access token
REFRESH_EXPIRY_DAYS="30"

# Config flags (mirror blueprint §18)
KYC_REQUIRED="true"
ARTIST_REAPPLY_DAYS="30"
AUTO_FEATURED="false"
REVIEW_GATE="purchased_only"   // purchased_only | all_buyers
PAYOUT_CURRENCY="INR"
MIN_PORTFOLIO_IMGS="3"
PLATFORM_FEE="0.15"            // 15% commission

# Event bus
EVENTS_TOPIC="tia.events"
